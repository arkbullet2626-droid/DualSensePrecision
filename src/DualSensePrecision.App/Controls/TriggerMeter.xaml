<UserControl
    x:Class="DualSensePrecision.App.Controls.TriggerMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="12" RowSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="56" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="14" />
        </Grid.RowDefinitions>

        <TextBlock Text="RAW" Style="{StaticResource DsLabel}" VerticalAlignment="Center" />
        <Grid x:Name="RawTrack" Grid.Column="1" SizeChanged="OnSizeChanged">
            <Border Background="{StaticResource DsSurfaceRaisedBrush}" CornerRadius="4" />
            <Border x:Name="RawFill" Background="{StaticResource DsTextSecondaryBrush}" CornerRadius="4" HorizontalAlignment="Left" Width="0" />
            <Canvas x:Name="Markers" />
        </Grid>
        <TextBlock x:Name="RawText" Grid.Column="2" Text="—" Style="{StaticResource DsMono}" HorizontalAlignment="Right" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Text="OUTPUT" Style="{StaticResource DsLabel}" VerticalAlignment="Center" />
        <Grid Grid.Row="1" Grid.Column="1">
            <Border Background="{StaticResource DsSurfaceRaisedBrush}" CornerRadius="4" />
            <Border x:Name="OutFill" Background="{StaticResource DsAccentBrush}" CornerRadius="4" HorizontalAlignment="Left" Width="0" />
        </Grid>
        <TextBlock x:Name="OutText" Grid.Row="1" Grid.Column="2" Text="—" Style="{StaticResource DsMono}" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{StaticResource DsTextPrimaryBrush}" />
    </Grid>
</UserControl>
