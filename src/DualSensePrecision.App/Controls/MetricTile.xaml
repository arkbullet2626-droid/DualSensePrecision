<UserControl
    x:Class="DualSensePrecision.App.Controls.MetricTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource DsCard}" Padding="16,14" MinWidth="160">
        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource DsLabel}" TextWrapping="Wrap" />
            <!-- One TextBlock with runs so a long value trims with "…" instead of clipping. -->
            <TextBlock Style="{StaticResource DsMetricValue}" FontSize="{x:Bind ValueFontSize, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Value, Mode=OneWay}">
                <Run Text="{x:Bind Value, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind Unit, Mode=OneWay}" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Normal" Foreground="{StaticResource DsTextSecondaryBrush}" />
            </TextBlock>
            <TextBlock Text="{x:Bind Hint, Mode=OneWay}" Style="{StaticResource DsBody}" FontSize="11" />
        </StackPanel>
    </Border>
</UserControl>
