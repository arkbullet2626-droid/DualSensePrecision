<UserControl
    x:Class="DualSensePrecision.App.Controls.CurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root"
          Background="{StaticResource DsSurfaceRaisedBrush}"
          CornerRadius="6"
          SizeChanged="OnSizeChanged"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost"
          DoubleTapped="OnDoubleTapped"
          RightTapped="OnRightTapped">
        <Canvas x:Name="GridLayer" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <Polyline x:Name="Diagonal" Stroke="{StaticResource DsTextTertiaryBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
            <Polyline x:Name="CurveLine" Stroke="{StaticResource DsAccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" />
            <Line x:Name="InputLine" Stroke="{StaticResource DsSuccessBrush}" StrokeThickness="1" StrokeDashArray="2,3" Visibility="Collapsed" />
            <Ellipse x:Name="InputDot" Width="10" Height="10" Fill="{StaticResource DsSuccessBrush}" Visibility="Collapsed" />
        </Canvas>
        <Canvas x:Name="HandleLayer" IsHitTestVisible="False" />
        <TextBlock Text="OUTPUT" Style="{StaticResource DsLabel}" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        <TextBlock Text="INPUT →" Style="{StaticResource DsLabel}" Margin="0,0,16,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" />
    </Grid>
</UserControl>
