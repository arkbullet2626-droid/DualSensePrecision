<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DualSense Precision design system.
        Dark-first, low-chroma surfaces, one accent, semantic colours used only for state.
        Spacing scale: 4 / 8 / 12 / 16 / 24 / 32.  Radius: 6 (controls), 10 (cards).
    -->

    <!-- Surfaces -->
    <Color x:Key="DsBackgroundColor">#0B0D12</Color>
    <Color x:Key="DsSurfaceColor">#12151C</Color>
    <Color x:Key="DsSurfaceRaisedColor">#181C25</Color>
    <Color x:Key="DsStrokeColor">#232836</Color>
    <Color x:Key="DsTextPrimaryColor">#E8EBF2</Color>
    <Color x:Key="DsTextSecondaryColor">#8A93A6</Color>
    <Color x:Key="DsTextTertiaryColor">#5C6475</Color>

    <!-- Accent + semantic -->
    <Color x:Key="DsAccentColor">#3D7BFF</Color>
    <Color x:Key="DsAccentSoftColor">#1F3D7BFF</Color>
    <Color x:Key="DsSuccessColor">#3DDC97</Color>
    <Color x:Key="DsWarningColor">#FFB547</Color>
    <Color x:Key="DsDangerColor">#FF5C6C</Color>
    <Color x:Key="DsInfoColor">#8A93A6</Color>

    <SolidColorBrush x:Key="DsBackgroundBrush" Color="{StaticResource DsBackgroundColor}" />
    <SolidColorBrush x:Key="DsSurfaceBrush" Color="{StaticResource DsSurfaceColor}" />
    <SolidColorBrush x:Key="DsSurfaceRaisedBrush" Color="{StaticResource DsSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="DsStrokeBrush" Color="{StaticResource DsStrokeColor}" />
    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="{StaticResource DsTextPrimaryColor}" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="{StaticResource DsTextSecondaryColor}" />
    <SolidColorBrush x:Key="DsTextTertiaryBrush" Color="{StaticResource DsTextTertiaryColor}" />
    <SolidColorBrush x:Key="DsAccentBrush" Color="{StaticResource DsAccentColor}" />
    <SolidColorBrush x:Key="DsAccentSoftBrush" Color="{StaticResource DsAccentSoftColor}" />
    <SolidColorBrush x:Key="DsSuccessBrush" Color="{StaticResource DsSuccessColor}" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="{StaticResource DsWarningColor}" />
    <SolidColorBrush x:Key="DsDangerBrush" Color="{StaticResource DsDangerColor}" />

    <!-- Override WinUI accent so stock controls (sliders, toggles) match. -->
    <Color x:Key="SystemAccentColor">#3D7BFF</Color>
    <Color x:Key="SystemAccentColorLight1">#5A8FFF</Color>
    <Color x:Key="SystemAccentColorLight2">#7AA5FF</Color>
    <Color x:Key="SystemAccentColorLight3">#9BBBFF</Color>
    <Color x:Key="SystemAccentColorDark1">#2F66DB</Color>
    <Color x:Key="SystemAccentColorDark2">#2552B5</Color>
    <Color x:Key="SystemAccentColorDark3">#1C3F8C</Color>

    <CornerRadius x:Key="DsCardRadius">10</CornerRadius>
    <CornerRadius x:Key="DsControlRadius">6</CornerRadius>
    <Thickness x:Key="DsPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="DsCardPadding">20</Thickness>

    <!-- Typography -->
    <Style x:Key="DsPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="DsPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="DsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="DsBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource DsTextTertiaryBrush}" />
    </Style>
    <Style x:Key="DsMetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="DsMono" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="DsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DsCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource DsCardPadding}" />
    </Style>
    <Style x:Key="DsInsetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DsControlRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="DsPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
