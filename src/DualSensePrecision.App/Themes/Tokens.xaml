<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DualSense Precision design system, in the Opifex Studios palette (opifexstudios.ca):
        warm near-black surfaces, cream text, "volt" amber accent with an ember gradient, mint/coral for state.
        Type: Oxanium (display), Figtree (body), IBM Plex Mono (numbers) - bundled, SIL Open Font License.
        Spacing scale: 4 / 8 / 12 / 16 / 24 / 32.  Radius: 3 (controls), 6 (cards) - sharp, like the site.
    -->

    <!-- Stock WinUI controls (toggles, sliders, accent buttons, selection) follow the Opifex accent. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#F2B544</Color>
            <Color x:Key="SystemAccentColorLight1">#F5C366</Color>
            <Color x:Key="SystemAccentColorLight2">#F2B544</Color>
            <Color x:Key="SystemAccentColorLight3">#F8D58F</Color>
            <Color x:Key="SystemAccentColorDark1">#D99A2B</Color>
            <Color x:Key="SystemAccentColorDark2">#B37D1F</Color>
            <Color x:Key="SystemAccentColorDark3">#8C6015</Color>
            <!-- Dark text on amber, like the site's buttons (white on amber is hard to read). -->
            <Color x:Key="TextOnAccentFillColorPrimary">#1A1408</Color>
            <Color x:Key="TextOnAccentFillColorSecondary">#3A2C12</Color>
            <Color x:Key="TextOnAccentFillColorDisabled">#75695A</Color>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A1408" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#3A2C12" />
            <!-- Accent fills used by toggles, sliders, accent buttons and selection indicators (owned here so
                 Settings → Interface → Colours can recolour them live). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6F2B544" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF2B544" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F5C366" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D99A2B" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#F2EBDD" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B0906" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B0906" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0B0906" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0E0B07" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#2E2617" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#15110B" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1C170F" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#241D12" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#15110B" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2E2617" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0B0906" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#120E09" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2EBDD" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A3967E" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#75695A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#F2B544</Color>
            <Color x:Key="SystemAccentColorLight1">#F5C366</Color>
            <Color x:Key="SystemAccentColorLight2">#F2B544</Color>
            <Color x:Key="SystemAccentColorLight3">#F8D58F</Color>
            <Color x:Key="SystemAccentColorDark1">#D99A2B</Color>
            <Color x:Key="SystemAccentColorDark2">#B37D1F</Color>
            <Color x:Key="SystemAccentColorDark3">#8C6015</Color>
            <!-- Dark text on amber, like the site's buttons (white on amber is hard to read). -->
            <Color x:Key="TextOnAccentFillColorPrimary">#1A1408</Color>
            <Color x:Key="TextOnAccentFillColorSecondary">#3A2C12</Color>
            <Color x:Key="TextOnAccentFillColorDisabled">#75695A</Color>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A1408" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#3A2C12" />
            <!-- Accent fills used by toggles, sliders, accent buttons and selection indicators (owned here so
                 Settings → Interface → Colours can recolour them live). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6F2B544" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF2B544" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F5C366" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D99A2B" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#F2EBDD" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B0906" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B0906" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0B0906" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0E0B07" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#2E2617" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#15110B" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1C170F" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#241D12" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#15110B" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2E2617" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0B0906" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#120E09" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2EBDD" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A3967E" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#75695A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Fonts (bundled in Assets\Fonts) -->
    <FontFamily x:Key="DsDisplayFont">ms-appx:///Assets/Fonts/Oxanium.ttf#Oxanium</FontFamily>
    <FontFamily x:Key="DsBodyFont">ms-appx:///Assets/Fonts/Figtree.ttf#Figtree</FontFamily>
    <FontFamily x:Key="DsMonoFont">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>
    <!-- Default font for every stock control and TextBlock. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Figtree.ttf#Figtree</FontFamily>

    <!-- Surfaces -->
    <Color x:Key="DsBackgroundColor">#0B0906</Color>
    <Color x:Key="DsSurfaceColor">#15110B</Color>
    <Color x:Key="DsSurfaceRaisedColor">#1C170F</Color>
    <Color x:Key="DsStrokeColor">#2E2617</Color>
    <Color x:Key="DsTextPrimaryColor">#F2EBDD</Color>
    <Color x:Key="DsTextSecondaryColor">#A3967E</Color>
    <Color x:Key="DsTextTertiaryColor">#75695A</Color>

    <!-- Accent + semantic -->
    <Color x:Key="DsAccentColor">#F2B544</Color>
    <Color x:Key="DsAccentSoftColor">#26F2B544</Color>
    <Color x:Key="DsEmberColor">#E0782F</Color>
    <Color x:Key="DsOnAccentColor">#1A1408</Color>
    <Color x:Key="DsSuccessColor">#5BE3A6</Color>
    <Color x:Key="DsWarningColor">#E0782F</Color>
    <Color x:Key="DsDangerColor">#FF7A6B</Color>
    <Color x:Key="DsInfoColor">#A3967E</Color>

    <SolidColorBrush x:Key="DsBackgroundBrush" Color="{StaticResource DsBackgroundColor}" />
    <SolidColorBrush x:Key="DsSurfaceBrush" Color="{StaticResource DsSurfaceColor}" />
    <SolidColorBrush x:Key="DsSurfaceRaisedBrush" Color="{StaticResource DsSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="DsStrokeBrush" Color="{StaticResource DsStrokeColor}" />
    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="{StaticResource DsTextPrimaryColor}" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="{StaticResource DsTextSecondaryColor}" />
    <SolidColorBrush x:Key="DsTextTertiaryBrush" Color="{StaticResource DsTextTertiaryColor}" />
    <SolidColorBrush x:Key="DsAccentBrush" Color="{StaticResource DsAccentColor}" />
    <SolidColorBrush x:Key="DsAccentSoftBrush" Color="{StaticResource DsAccentSoftColor}" />
    <SolidColorBrush x:Key="DsEmberBrush" Color="{StaticResource DsEmberColor}" />
    <SolidColorBrush x:Key="DsOnAccentBrush" Color="{StaticResource DsOnAccentColor}" />
    <SolidColorBrush x:Key="DsSuccessBrush" Color="{StaticResource DsSuccessColor}" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="{StaticResource DsWarningColor}" />
    <SolidColorBrush x:Key="DsDangerBrush" Color="{StaticResource DsDangerColor}" />
    <!-- The DP logo: one solid colour that follows the theme (Settings → Interface → Colours → Logo). -->
    <SolidColorBrush x:Key="DsLogoBrush" Color="#F2B544" />
    <LinearGradientBrush x:Key="DsHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A1D0B" Offset="0" />
        <GradientStop Color="#15110B" Offset="0.65" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DsVoltGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F2B544" Offset="0" />
        <GradientStop Color="#E0782F" Offset="1" />
    </LinearGradientBrush>


    <CornerRadius x:Key="DsCardRadius">6</CornerRadius>
    <CornerRadius x:Key="DsControlRadius">3</CornerRadius>
    <Thickness x:Key="DsPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="DsCardPadding">20</Thickness>

    <!-- Typography -->
    <Style x:Key="DsPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsDisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="DsPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="DsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsDisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="DsBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DsLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DsMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource DsTextTertiaryBrush}" />
    </Style>
    <Style x:Key="DsMetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource DsMonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="DsMono" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource DsMonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="DsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DsCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource DsCardPadding}" />
    </Style>
    <Style x:Key="DsInsetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DsControlRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="DsPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
