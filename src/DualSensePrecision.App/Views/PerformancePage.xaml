<Page
    x:Class="DualSensePrecision.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DualSensePrecision.App.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Performance" Style="{StaticResource DsPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" Style="{StaticResource DsPageSubtitle}" />
            </StackPanel>

            <!-- Headline -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:MetricTile Label="REPORT RATE" Value="{x:Bind ViewModel.MeasuredRate, Mode=OneWay}" Unit="Hz" Hint="Physical rate, measured" />
                <controls:MetricTile Grid.Column="1" Label="AVERAGE INTERVAL" Value="{x:Bind ViewModel.AvgInterval, Mode=OneWay}" Unit="ms" Hint="Time between reports" />
                <controls:MetricTile Grid.Column="2" Label="PROCESSING TIME" Value="{x:Bind ViewModel.ProcessingAvg, Mode=OneWay}" Unit="µs" Hint="Input → processed output, average" />
                <controls:MetricTile Grid.Column="3" Label="APP CPU" Value="{x:Bind ViewModel.Cpu, Mode=OneWay}" Unit="%" Hint="Share of total CPU" />
            </Grid>

            <!-- Live interval graph -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Report interval — live" Style="{StaticResource DsSectionTitle}" />
                        <TextBlock x:Name="GraphScale" HorizontalAlignment="Right" Style="{StaticResource DsMono}" />
                    </Grid>
                    <Grid x:Name="GraphHost" Height="200" Background="{StaticResource DsSurfaceRaisedBrush}" CornerRadius="6" SizeChanged="OnGraphSizeChanged">
                        <Line x:Name="MedianLine" Stroke="{StaticResource DsTextTertiaryBrush}" StrokeThickness="1" StrokeDashArray="4,4" />
                        <Polyline x:Name="IntervalLine" Stroke="{StaticResource DsAccentBrush}" StrokeThickness="1.5" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.Verdict, Mode=OneWay}" Style="{StaticResource DsBody}" />
                </StackPanel>
            </Border>

            <!-- Distribution -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <controls:MetricTile Label="P50 INTERVAL" Value="{x:Bind ViewModel.P50, Mode=OneWay}" Unit="ms" Hint="Median" />
                <controls:MetricTile Grid.Column="1" Label="P95 INTERVAL" Value="{x:Bind ViewModel.P95, Mode=OneWay}" Unit="ms" />
                <controls:MetricTile Grid.Column="2" Label="P99 INTERVAL" Value="{x:Bind ViewModel.P99, Mode=OneWay}" Unit="ms" />
                <controls:MetricTile Grid.Column="3" Label="MAX INTERVAL" Value="{x:Bind ViewModel.MaxInterval, Mode=OneWay}" Unit="ms" Hint="Worst gap in window" />
                <controls:MetricTile Grid.Row="1" Label="DROPPED REPORTS" Value="{x:Bind ViewModel.Dropped, Mode=OneWay}" Hint="Gaps in controller sequence counter" />
                <controls:MetricTile Grid.Row="1" Grid.Column="1" Label="STALLS" Value="{x:Bind ViewModel.Stalls, Mode=OneWay}" Hint="Interval &gt; 4× median" />
                <controls:MetricTile Grid.Row="1" Grid.Column="2" Label="PROCESSING P99" Value="{x:Bind ViewModel.ProcessingP99, Mode=OneWay}" Unit="µs" />
                <controls:MetricTile Grid.Row="1" Grid.Column="3" Label="VIRTUAL OUTPUT" Value="{x:Bind ViewModel.VirtualRate, Mode=OneWay}" Unit="Hz" Hint="Packets sent to the virtual controller" />
            </Grid>

            <!-- Output rate -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Virtual output rate" Style="{StaticResource DsSectionTitle}" />
                    <TextBlock Style="{StaticResource DsBody}"
                               Text="This sets how often processed input is forwarded to a virtual controller. It cannot make the DualSense send reports faster — the controller's own USB report rate is fixed in hardware and is measured above." />
                    <ComboBox Width="300" ItemsSource="{x:Bind ViewModel.OutputRateLabels}"
                              SelectedIndex="{x:Bind ViewModel.SelectedOutputRateIndex, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.OutputNote, Mode=OneWay}" Style="{StaticResource DsBody}" Foreground="{StaticResource DsTextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
