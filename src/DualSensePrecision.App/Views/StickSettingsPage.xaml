<Page
    x:Class="DualSensePrecision.App.Views.StickSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DualSensePrecision.App.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="1240" HorizontalAlignment="Left">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Stick Settings" Style="{StaticResource DsPageTitle}" />
                    <TextBlock Style="{StaticResource DsPageSubtitle}">
                        <Run Text="Editing profile" /> <Run Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource DsTextPrimaryBrush}" /><Run Text=". Changes apply instantly and save automatically." />
                    </TextBlock>
                </StackPanel>
                <SelectorBar x:Name="StickSelector" HorizontalAlignment="Right" VerticalAlignment="Bottom" SelectionChanged="OnStickSelected">
                    <SelectorBarItem Text="Left stick" IsSelected="True" />
                    <SelectorBarItem Text="Right stick" />
                </SelectorBar>
            </Grid>

            <InfoBar IsOpen="True" IsClosable="True" Severity="Informational"
                     Title="Where these settings take effect"
                     Message="The processed output (blue dot) is what a virtual controller will send to games. Until a virtual controller is set up, games still read your controller directly, so these settings preview here but don't change in-game aim yet." />

            <!-- Live view + curve -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DsCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Live view" Style="{StaticResource DsSectionTitle}" />
                        <controls:StickVisualizer x:Name="Visualizer" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource DsTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Raw" Style="{StaticResource DsBody}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource DsAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Processed" Style="{StaticResource DsBody}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="9" Height="9" Fill="#99FF5C6C" VerticalAlignment="Center" />
                                <TextBlock Text="Deadzone" Style="{StaticResource DsBody}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="RAW" Style="{StaticResource DsLabel}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RawText" Grid.Column="1" Text="—" Style="{StaticResource DsMono}" />
                            <TextBlock Grid.Row="1" Text="OUTPUT" Style="{StaticResource DsLabel}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProcessedText" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource DsMono}" Foreground="{StaticResource DsTextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Text="DEFLECTION" Style="{StaticResource DsLabel}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeflectionText" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource DsMono}" Foreground="{StaticResource DsTextPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DsCard}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="300" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Response curve" Style="{StaticResource DsSectionTitle}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" MinWidth="190" SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Linear" />
                                <ComboBoxItem Content="Precision" />
                                <ComboBoxItem Content="Smooth" />
                                <ComboBoxItem Content="Aggressive" />
                                <ComboBoxItem Content="Exponential" />
                                <ComboBoxItem Content="Competitive FPS" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>
                        </Grid>
                        <controls:CurveEditor x:Name="Curve" Grid.Row="1" />
                        <TextBlock Grid.Row="2" Style="{StaticResource DsBody}" FontSize="12"
                                   Text="Drag the blue points to reshape. Double-click to add a point, right-click a point to remove it. Below the dashed line = slower, more precise small movements; above = faster response. The green marker is your stick right now." />
                    </Grid>
                </Border>
            </Grid>

            <!-- Tuning -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DsCard}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Deadzones" Style="{StaticResource DsSectionTitle}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" MinWidth="170" SelectedIndex="{x:Bind ViewModel.DeadzoneShapeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Radial (round)" />
                                <ComboBoxItem Content="Axial (per axis)" />
                            </ComboBox>
                        </Grid>
                        <controls:SliderRow Label="Inner deadzone" Minimum="0" Maximum="0.5" Step="0.005" Format="Percent"
                                            Value="{x:Bind ViewModel.InnerDeadzone, Mode=TwoWay}"
                                            Description="Movement smaller than this is ignored. Raise it if the stick drifts at rest." />
                        <controls:SliderRow Label="Outer deadzone" Minimum="0.5" Maximum="1" Step="0.005" Format="Percent"
                                            Value="{x:Bind ViewModel.OuterDeadzone, Mode=TwoWay}"
                                            Description="Output reaches 100% at this deflection. Lower it if full speed is hard to hit." />
                        <controls:SliderRow Label="Anti-deadzone" Minimum="0" Maximum="0.5" Step="0.005" Format="Percent"
                                            Value="{x:Bind ViewModel.AntiDeadzone, Mode=TwoWay}"
                                            Description="Output starts at this level as soon as you leave the deadzone. Use to cancel a game's own deadzone." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DsCard}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Sensitivity &amp; output" Style="{StaticResource DsSectionTitle}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" MinWidth="170" SelectedIndex="{x:Bind ViewModel.OutputShapeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Circular output" />
                                <ComboBoxItem Content="Square output" />
                            </ComboBox>
                        </Grid>
                        <controls:SliderRow Label="Horizontal sensitivity (X)" Minimum="0.2" Maximum="2" Step="0.01" Format="Multiplier"
                                            Value="{x:Bind ViewModel.SensitivityX, Mode=TwoWay}"
                                            Description="Scales left/right output after the curve." />
                        <controls:SliderRow Label="Vertical sensitivity (Y)" Minimum="0.2" Maximum="2" Step="0.01" Format="Multiplier"
                                            Value="{x:Bind ViewModel.SensitivityY, Mode=TwoWay}"
                                            Description="Scales up/down output. Many players run Y slightly lower than X." />
                        <ToggleSwitch Header="Invert vertical axis" IsOn="{x:Bind ViewModel.InvertY, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource DsBody}" FontSize="12"
                                   Text="Square output lets diagonals reach 100% on both axes at once, which some games expect. Circular keeps total output within the circle." />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Reset this stick to defaults" Click="OnResetStick" />
                <TextBlock x:Name="SaveStatus" Style="{StaticResource DsBody}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
