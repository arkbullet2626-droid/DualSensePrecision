<Page
    x:Class="DualSensePrecision.App.Views.FeatureStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualSensePrecision.App.Views"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource DsPageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource DsPageSubtitle}" />
            </StackPanel>

            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" Severity="Informational" />

            <Border Style="{StaticResource DsCard}" Padding="0">
                <StackPanel>
                    <Grid Padding="20,14">
                        <TextBlock Text="FEATURE STATUS" Style="{StaticResource DsLabel}" />
                    </Grid>
                    <ItemsControl x:Name="FeatureList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FeatureItem">
                                <Grid Padding="20,14" BorderBrush="{StaticResource DsStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" Foreground="{StaticResource DsTextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Note}" Style="{StaticResource DsBody}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource DsPill}" BorderBrush="{x:Bind StatusBrush}" BorderThickness="1">
                                        <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Milestone}" Style="{StaticResource DsMono}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
