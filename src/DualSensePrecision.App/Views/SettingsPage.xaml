<Page
    x:Class="DualSensePrecision.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource DsPageTitle}" />
                <TextBlock Text="Stored in %LOCALAPPDATA%\DualSensePrecision. Nothing here requires administrator rights." Style="{StaticResource DsPageSubtitle}" />
            </StackPanel>

            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Controller" Style="{StaticResource DsSectionTitle}" />
                    <ToggleSwitch x:Name="AutoDetect" Header="Automatic controller detection" Toggled="OnChanged" />
                    <ComboBox x:Name="Preferred" Header="When a DualSense and an Xbox controller are both connected, use" SelectionChanged="OnPreferredChanged" MinWidth="260">
                        <ComboBoxItem Content="The DualSense" />
                        <ComboBoxItem Content="The Xbox controller" />
                    </ComboBox>
                    <ToggleSwitch x:Name="Mock" Header="Use simulated controller (development)" Toggled="OnChanged" />
                    <TextBlock Style="{StaticResource DsBody}" Text="The simulated controller exists for UI development. Every screen marks its data as simulated, and none of it is a hardware measurement." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Startup and background" Style="{StaticResource DsSectionTitle}" />
                    <ToggleSwitch x:Name="StartWithWindows" Header="Start with Windows (in the tray, so your controller settings are ready before you open a game)" Toggled="OnStartupToggled" />
                    <ToggleSwitch x:Name="CloseToTray" Header="Closing the window keeps the app running in the tray" Toggled="OnChanged" />
                    <TextBlock Style="{StaticResource DsBody}" Text="While it runs in the tray, your profile, remaps, the virtual controller and hiding keep working. To quit completely, right-click the tray icon and choose Exit." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Updates" Style="{StaticResource DsSectionTitle}" />
                    <ToggleSwitch x:Name="CheckUpdates" Header="Check GitHub for a new version when the app starts" Toggled="OnChanged" />
                    <TextBlock Style="{StaticResource DsBody}" Text="Only the newest version number is requested. Nothing about you or your PC is sent. You can also check from About." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Interface" Style="{StaticResource DsSectionTitle}" />
                    <ToggleSwitch x:Name="Animations" Header="Page transitions and animations" Toggled="OnChanged" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Interface scale" Foreground="{StaticResource DsTextPrimaryBrush}" />
                            <TextBlock x:Name="ScaleValue" HorizontalAlignment="Right" FontFamily="{StaticResource DsMonoFont}" Foreground="{StaticResource DsTextPrimaryBrush}" />
                        </Grid>
                        <Slider x:Name="ScaleSlider" Minimum="75" Maximum="150" StepFrequency="5" TickFrequency="25" TickPlacement="Outside"
                                ValueChanged="OnScaleChanged" MaxWidth="520" HorizontalAlignment="Left" Width="520" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="100 %" Click="OnScaleReset" />
                            <TextBlock Style="{StaticResource DsBody}" VerticalAlignment="Center"
                                       Text="Makes everything in the window bigger or smaller. Pop-up dialogs follow Windows' own display scaling." />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Colours" Foreground="{StaticResource DsTextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource DsBody}"
                                   Text="Pick any colour for the background, panels, borders and text: click a swatch to drag the colour picker, or type a hex code like #15110B. Changes show straight away. Lighter shades (secondary text, raised panels) are worked out from these. The amber accent stays the Opifex colour." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="PresetBox" Header="Start from a preset" MinWidth="220" SelectionChanged="OnPresetChanged" />
                            <Button Content="Reset to Opifex colours" VerticalAlignment="Bottom" Click="OnColorsReset" />
                        </StackPanel>
                        <StackPanel x:Name="ColorRows" Spacing="8" />
                        <TextBlock x:Name="ContrastText" Style="{StaticResource DsBody}" />
                        <StackPanel x:Name="RestartHint" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource DsBody}" VerticalAlignment="Center"
                                       Text="You switched between a light and a dark theme. Pop-up menus and dialogs switch over after a restart." />
                            <Button Content="Restart now" Click="OnRestartForTheme" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Troubleshooting" Style="{StaticResource DsSectionTitle}" />
                    <TextBlock Style="{StaticResource DsBody}" Text="The app keeps a small log of what it did (controller connected, virtual controller on/off, errors), never your button or stick input. Logs stay on your PC for 7 days." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open logs folder" Click="OnOpenLogs" />
                        <Button Content="Export diagnostics…" Click="OnExport" />
                        <Button Content="Reset app…" Click="OnReset" />
                    </StackPanel>
                    <TextBlock x:Name="ToolsText" Style="{StaticResource DsBody}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Virtual controller" Style="{StaticResource DsSectionTitle}" />
                    <TextBlock Style="{StaticResource DsBody}" Text="Uses VIIPER with the signed usbip-win2 driver (ViGEmBus wasn't used: it's archived and no longer updated). Hiding the real controller uses HidHide. Both are separate free programs that Setup can install for you, each with Windows' permission prompt. DualSense Precision never installs drivers on its own." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="SavedText" Style="{StaticResource DsBody}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource DsBody}" FontSize="12" Foreground="{StaticResource DsTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
