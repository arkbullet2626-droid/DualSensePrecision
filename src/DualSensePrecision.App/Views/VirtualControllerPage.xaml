<Page
    x:Class="DualSensePrecision.App.Views.VirtualControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="Virtual Controller" Style="{StaticResource DsPageTitle}" />
                <TextBlock Style="{StaticResource DsPageSubtitle}"
                           Text="Presents your tuned controller (DualSense or Xbox) to games as an Xbox 360 controller, so stick curves, deadzones, trigger settings and remaps take effect in-game." />
            </StackPanel>

            <!-- Main switch + status -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateTitle" Style="{StaticResource DsSectionTitle}" FontSize="17" />
                            </StackPanel>
                            <TextBlock x:Name="StateDetail" Style="{StaticResource DsBody}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnableSwitch" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      OnContent="Xbox 360 on" OffContent="Off" Toggled="OnEnableToggled" />
                    </Grid>
                    <TextBlock Style="{StaticResource DsBody}" FontSize="12" Foreground="{StaticResource DsTextTertiaryBrush}"
                               Text="Saved per profile. Switching profiles turns it on or off to match." />
                </StackPanel>
            </Border>

            <!-- Hide the real controller (HidHide) -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Spacing="4" Margin="0,0,140,0">
                            <TextBlock Text="Hide your real controller from games" Style="{StaticResource DsSectionTitle}" />
                            <TextBlock Style="{StaticResource DsBody}" TextWrapping="Wrap"
                                       Text="Stops games seeing two controllers (e.g. Rocket League adding a second player). Uses the free HidHide driver. Only while the virtual controller is on; undone when you switch off or close the app." />
                        </StackPanel>
                        <ToggleSwitch x:Name="HideSwitch" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      OnContent="On" OffContent="Off" Toggled="OnHideToggled" />
                    </Grid>
                    <TextBlock x:Name="HideStatus" Style="{StaticResource DsBody}" Foreground="{StaticResource DsTextPrimaryBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="HideInstallHelp" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource DsBody}" TextWrapping="Wrap" Foreground="{StaticResource DsWarningBrush}"
                                   Text="HidHide isn't installed. Run the DualSense Precision setup again and tick 'Download and install HidHide'. Windows asks for permission for the driver, then restart Windows." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckButton" Content="Check what games see" Click="OnCheckGames" />
                        <ProgressRing x:Name="CheckRing" IsActive="False" Width="18" Height="18" />
                    </StackPanel>
                    <TextBlock x:Name="CheckResult" Style="{StaticResource DsBody}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Live verification -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="What Windows sees" Style="{StaticResource DsSectionTitle}" />
                    <TextBlock Style="{StaticResource DsBody}" FontSize="12"
                               Text="Read back through XInput, the same way games read Xbox controllers. If these values move with your sticks, games will see them. (This app is allowed to see hidden controllers, so your real one still appears here.)" />
                    <TextBlock x:Name="XInputText" Style="{StaticResource DsMono}" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SENDING" Style="{StaticResource DsLabel}" />
                            <TextBlock x:Name="RateText" Text="—" Style="{StaticResource DsMetricValue}" FontSize="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GAME RUMBLE" Style="{StaticResource DsLabel}" />
                            <TextBlock x:Name="RumbleText" Text="—" Style="{StaticResource DsMetricValue}" FontSize="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VIIPER" Style="{StaticResource DsLabel}" />
                            <TextBlock x:Name="VersionText" Text="—" Style="{StaticResource DsMetricValue}" FontSize="20" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Setup -->
            <Border x:Name="SetupCard" Style="{StaticResource DsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="One-time setup" Style="{StaticResource DsSectionTitle}" />
                    <TextBlock Style="{StaticResource DsBody}"
                               Text="The virtual controller needs VIIPER, a free open-source tool, plus the signed usbip-win2 driver it installs. DualSense Precision never installs drivers without your say-so." />
                    <TextBlock Style="{StaticResource DsBody}" Foreground="{StaticResource DsTextPrimaryBrush}" TextWrapping="Wrap"
                               Text="Easiest: run the DualSense Precision setup again and leave 'Download and install VIIPER' ticked. Windows asks for permission for the driver; restart if it asks." />
                    <TextBlock Style="{StaticResource DsBody}" Foreground="{StaticResource DsTextPrimaryBrush}" Text="Or install it yourself in PowerShell:" />
                    <Border Style="{StaticResource DsInsetCard}">
                        <TextBlock Text="winget install Alia5.VIIPER" Style="{StaticResource DsMono}" Foreground="{StaticResource DsTextPrimaryBrush}" />
                    </Border>
                    <TextBlock Style="{StaticResource DsBody}" TextWrapping="Wrap"
                               Text="then start VIIPER from the Start menu, choose Install, and keep 'Install USBIP' and 'Autostart' ticked." />
                    <HyperlinkButton Content="VIIPER on GitHub" NavigateUri="https://github.com/Alia5/VIIPER" Padding="0" />
                </StackPanel>
            </Border>

            <!-- Double input -->
            <InfoBar x:Name="DoubleInputBar" IsOpen="True" IsClosable="False" Severity="Warning" Title="Games may see two controllers"
                     Message="Without hiding, Windows shows games your real controller as well as the virtual one, so they can get doubled input or add a second player. Switch on 'Hide your real controller from games' above. For Steam games, also set the game's Properties → Controller to 'Disable Steam Input'." />
        </StackPanel>
    </ScrollViewer>
</Page>
