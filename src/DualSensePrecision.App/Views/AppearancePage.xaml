<Page
    x:Class="DualSensePrecision.App.Views.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DualSensePrecision.App.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="1240" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource DsPageTitle}" />
                <TextBlock Style="{StaticResource DsPageSubtitle}">
                    <Run Text="Lights and vibration for profile" /> <Run Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource DsTextPrimaryBrush}" /><Run Text=". Every change is sent to your controller right away." />
                </TextBlock>
            </StackPanel>

            <InfoBar x:Name="OutputError" IsOpen="False" Severity="Warning" Title="Controller output" />

            <InfoBar x:Name="XboxBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="Xbox controller"
                     Message="Only vibration applies to Xbox controllers. The lightbar, player lights, mute light and adaptive triggers are DualSense hardware, so they're hidden here and kept in the profile for when you use a DualSense." />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Lightbar -->
                <Border x:Name="LightbarCard" Style="{StaticResource DsCard}" VerticalAlignment="Top">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Lightbar" Style="{StaticResource DsSectionTitle}" />

                        <!-- Preview: two lightbar strips either side of a touchpad outline -->
                        <Grid Height="64" HorizontalAlignment="Center" Width="300">
                            <Border Width="190" Height="54" CornerRadius="10" BorderBrush="{StaticResource DsStrokeBrush}" BorderThickness="1.5" Background="{StaticResource DsSurfaceRaisedBrush}" />
                            <Border x:Name="PreviewLeft" Width="8" Height="44" CornerRadius="4" HorizontalAlignment="Left" Margin="40,0,0,0" />
                            <Border x:Name="PreviewRight" Width="8" Height="44" CornerRadius="4" HorizontalAlignment="Right" Margin="0,0,40,0" />
                        </Grid>

                        <ColorPicker x:Name="Picker" ColorChanged="OnPickerColorChanged"
                                     ColorSpectrumShape="Ring"
                                     IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False"
                                     IsColorSliderVisible="False"
                                     IsColorChannelTextInputVisible="False"
                                     IsHexInputVisible="True"
                                     HorizontalAlignment="Center" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="QUICK COLOURS" Style="{StaticResource DsLabel}" />
                            <VariableSizedWrapGrid x:Name="SwatchPanel" Orientation="Horizontal" ItemWidth="40" ItemHeight="40" />
                        </StackPanel>

                        <controls:SliderRow Label="Brightness" Minimum="0" Maximum="1" Step="0.01" Format="Percent"
                                            Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}"
                                            Description="0% turns the lightbar off." />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <!-- Player LEDs -->
                    <Border x:Name="PlayerCard" Style="{StaticResource DsCard}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Player indicator" Style="{StaticResource DsSectionTitle}" VerticalAlignment="Center" />
                                <ComboBox HorizontalAlignment="Right" MinWidth="140" SelectedIndex="{x:Bind ViewModel.LedBrightnessIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Bright" />
                                    <ComboBoxItem Content="Medium" />
                                    <ComboBoxItem Content="Dim" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Style="{StaticResource DsBody}" FontSize="12" Text="The five small lights under the touchpad. Click to turn each on or off." />
                            <StackPanel x:Name="LedPanel" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Mute LED -->
                    <Border x:Name="MuteCard" Style="{StaticResource DsCard}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Mute button light" Style="{StaticResource DsSectionTitle}" />
                                <TextBlock Style="{StaticResource DsBody}" FontSize="12" Text="On PC the mute light doesn't follow your mic — set it here." />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="140" SelectedIndex="{x:Bind ViewModel.MuteLedIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="On" />
                                <ComboBoxItem Content="Pulsing" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Motors -->
                    <Border Style="{StaticResource DsCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Vibration &amp; trigger strength" Style="{StaticResource DsSectionTitle}" />
                            <controls:SliderRow Label="Vibration strength" Minimum="0" Maximum="1" Step="0.125" Format="Percent"
                                                Value="{x:Bind ViewModel.RumbleIntensity, Mode=TwoWay}"
                                                Description="Caps rumble from games and the test below. The controller supports 8 levels." />
                            <controls:SliderRow x:Name="TriggerStrengthRow" Label="Adaptive trigger strength" Minimum="0" Maximum="1" Step="0.125" Format="Percent"
                                                Value="{x:Bind ViewModel.TriggerIntensity, Mode=TwoWay}"
                                                Description="Caps how hard trigger resistance can push back. Lowest setting still gives light resistance." />
                            <Button Content="Test vibration" Click="OnTestRumble" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Reset appearance to defaults" Click="OnReset" />
                <TextBlock Style="{StaticResource DsBody}" VerticalAlignment="Center" FontSize="12"
                           Text="If the lights don't change, close Steam or any other controller app — they can take over the lightbar." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
