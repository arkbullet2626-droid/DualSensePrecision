<Page
    x:Class="DualSensePrecision.App.Views.TriggerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DualSensePrecision.App.Controls"
    xmlns:app="using:DualSensePrecision.App"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource DsPagePadding}" Spacing="20" MaxWidth="1240" HorizontalAlignment="Left">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Trigger Settings" Style="{StaticResource DsPageTitle}" />
                    <TextBlock Style="{StaticResource DsPageSubtitle}">
                        <Run Text="Editing profile" /> <Run Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource DsTextPrimaryBrush}" /><Run Text=". Changes apply instantly and save automatically." />
                    </TextBlock>
                </StackPanel>
                <SelectorBar HorizontalAlignment="Right" VerticalAlignment="Bottom" SelectionChanged="OnTriggerSelected">
                    <SelectorBarItem Text="L2 (left)" IsSelected="True" />
                    <SelectorBarItem Text="R2 (right)" />
                </SelectorBar>
            </Grid>

            <!-- Adaptive effect: real hardware output, so it goes first -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Adaptive trigger" Style="{StaticResource DsSectionTitle}" />
                            <TextBlock Style="{StaticResource DsBody}" FontSize="12" Text="Sent straight to your controller — pull the trigger to feel it." />
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="190" SelectedIndex="{x:Bind ViewModel.EffectIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="Resistance" />
                            <ComboBoxItem Content="Trigger click (weapon)" />
                            <ComboBoxItem Content="Vibration" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.EffectDescription, Mode=OneWay}" Style="{StaticResource DsBody}" />
                    <Grid ColumnSpacing="24" Visibility="{x:Bind app:Converters.VisibleWhen(ViewModel.ShowEffectParams), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="14">
                            <controls:SliderRow Label="{x:Bind ViewModel.StartLabel, Mode=OneWay}" Format="Plain" Step="1"
                                                Minimum="{x:Bind ViewModel.StartMin, Mode=OneWay}" Maximum="{x:Bind ViewModel.StartMax, Mode=OneWay}"
                                                Value="{x:Bind ViewModel.EffectStart, Mode=TwoWay}"
                                                Description="0 = as soon as you touch the trigger." />
                            <controls:SliderRow Label="Click point (zone)" Format="Plain" Step="1" Minimum="3" Maximum="8"
                                                Value="{x:Bind ViewModel.EffectEnd, Mode=TwoWay}"
                                                Visibility="{x:Bind app:Converters.VisibleWhen(ViewModel.ShowEnd), Mode=OneWay}"
                                                Description="Where the resistance breaks." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="14">
                            <controls:SliderRow Label="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}" Format="Plain" Step="1" Minimum="1" Maximum="8"
                                                Value="{x:Bind ViewModel.EffectStrength, Mode=TwoWay}"
                                                Description="1 = light, 8 = strongest." />
                            <controls:SliderRow Label="Frequency (Hz)" Format="Plain" Step="1" Minimum="1" Maximum="80"
                                                Value="{x:Bind ViewModel.EffectFrequency, Mode=TwoWay}"
                                                Visibility="{x:Bind app:Converters.VisibleWhen(ViewModel.ShowFrequency), Mode=OneWay}"
                                                Description="How fast the trigger buzzes." />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource DsBody}" FontSize="12" Foreground="{StaticResource DsTextTertiaryBrush}"
                               Text="Games with their own DualSense trigger effects (and Steam Input) can replace this while they're running. Resistance is switched off when you close the app." />
                </StackPanel>
            </Border>

            <!-- Live -->
            <Border Style="{StaticResource DsCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Live" Style="{StaticResource DsSectionTitle}" />
                        <TextBlock x:Name="StateText" HorizontalAlignment="Right" Style="{StaticResource DsMono}" />
                    </Grid>
                    <controls:TriggerMeter x:Name="Meter" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Style="{StaticResource DsBody}" FontSize="12"><Run Text="▍" Foreground="#FF5C6C" /> Deadzone</TextBlock>
                        <TextBlock Style="{StaticResource DsBody}" FontSize="12"><Run Text="▍" Foreground="{StaticResource DsSuccessBrush}" /> Activation point</TextBlock>
                        <TextBlock Style="{StaticResource DsBody}" FontSize="12"><Run Text="▍" Foreground="{StaticResource DsAccentBrush}" /> 100% point</TextBlock>
                        <TextBlock Style="{StaticResource DsBody}" FontSize="12"><Run Text="▍" Foreground="{StaticResource DsWarningBrush}" /> Full press</TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" IsClosable="True" Severity="Informational" Title="Input shaping"
                     Message="The settings below change the trigger value a virtual controller will send to games. Until a virtual controller is set up they preview here only. The adaptive trigger above already works everywhere." />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DsCard}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Input shaping" Style="{StaticResource DsSectionTitle}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" MinWidth="170" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Analog" />
                                <ComboBoxItem Content="Digital (hair trigger)" />
                                <ComboBoxItem Content="Dual-zone" />
                            </ComboBox>
                        </Grid>
                        <controls:SliderRow Label="Activation point" Minimum="0.01" Maximum="1" Step="0.01" Format="Percent"
                                            Value="{x:Bind ViewModel.ActivationPoint, Mode=TwoWay}"
                                            Description="How far you pull before it counts as pressed. Low = hair trigger." />
                        <StackPanel Spacing="14" Visibility="{x:Bind app:Converters.VisibleWhen(ViewModel.ShowAnalogControls), Mode=OneWay}">
                            <controls:SliderRow Label="Deadzone" Minimum="0" Maximum="0.5" Step="0.005" Format="Percent"
                                                Value="{x:Bind ViewModel.Deadzone, Mode=TwoWay}"
                                                Description="Pull below this reads as zero." />
                            <controls:SliderRow Label="100% point" Minimum="0.3" Maximum="1" Step="0.005" Format="Percent"
                                                Value="{x:Bind ViewModel.MaxPoint, Mode=TwoWay}"
                                                Description="Output reaches 100% here, so you don't need to bottom out the trigger." />
                            <controls:SliderRow Label="Sensitivity" Minimum="0.2" Maximum="2" Step="0.01" Format="Multiplier"
                                                Value="{x:Bind ViewModel.Sensitivity, Mode=TwoWay}"
                                                Description="Scales the output after the curve." />
                        </StackPanel>
                        <controls:SliderRow Label="Full-press point" Minimum="0.3" Maximum="1" Step="0.01" Format="Percent"
                                            Value="{x:Bind ViewModel.SecondStagePoint, Mode=TwoWay}"
                                            Visibility="{x:Bind app:Converters.VisibleWhen(ViewModel.ShowSecondStage), Mode=OneWay}"
                                            Description="Second stage: a separate 'full press' signal past this point (for mapping in a later update)." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DsCard}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="260" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Response curve" Style="{StaticResource DsSectionTitle}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" MinWidth="170" SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Linear" />
                                <ComboBoxItem Content="Precision" />
                                <ComboBoxItem Content="Smooth" />
                                <ComboBoxItem Content="Aggressive" />
                                <ComboBoxItem Content="Exponential" />
                                <ComboBoxItem Content="Competitive FPS" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>
                        </Grid>
                        <controls:CurveEditor x:Name="Curve" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Reset this trigger to defaults" Click="OnReset" />
                <TextBlock x:Name="SaveStatus" Style="{StaticResource DsBody}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
